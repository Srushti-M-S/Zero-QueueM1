rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if true;
    }

    // Explicit controls for critical collections (permissive but structured)
    match /users/{userId} {
      allow read, write: if true;
    }

    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    match /access_logs/{logId} {
      allow read, write: if true;
    }

    match /notification_requests/{requestId} {
      allow read, write: if true;
    }
  }
}
