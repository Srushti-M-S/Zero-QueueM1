rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
      
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'username', 'role']) &&
               data.uid is string &&
               data.username is string &&
               data.username.size() <= 50 &&
               data.role in ['admin', 'student'];
      }
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow read: if true; // Publicly readable for real-time dashboard
      allow create: if isSignedIn() && 
                      request.resource.data.userId == request.auth.uid &&
                      isValidBooking(request.resource.data);
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();

      function isValidBooking(data) {
        return data.keys().hasAll(['terminalId', 'labId', 'userId', 'username', 'startTime', 'duration', 'status']) &&
               data.terminalId is string &&
               data.labId is string &&
               data.status in ['active', 'completed', 'cancelled'];
      }
    }

    // Access Logs
    match /access_logs/{logId} {
      allow read: if true; 
      allow create: if isSignedIn();
      
      function isValidLog(data) {
        return data.userId is string &&
               data.timestamp == request.time;
      }
    }
  }
}
